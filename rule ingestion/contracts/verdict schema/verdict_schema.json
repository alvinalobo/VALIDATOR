{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict Event v2.0",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["Detected", "Missed", "Partial", "NoData"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "causal_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mttd_seconds": {
      "type": ["number", "null"]
    },
    "matched_evidence_ref": {
      "type": ["string", "null"]
    },
    "regulatory_control_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "required": [
    "action_id",
    "verdict",
    "confidence",
    "causal_chain",
    "mttd_seconds",
    "matched_evidence_ref",
    "regulatory_control_refs",
    "content_hash"
  ],
  "additionalProperties": false
}
